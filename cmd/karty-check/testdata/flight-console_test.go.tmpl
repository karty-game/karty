package main

import (
	"testing"

	"example.com/ui-demo/.karty/assets"
	"example.com/ui-demo/.karty/config"
	"example.com/ui-demo/.karty/engine"
)

func TestFlightConsoleControlsAndLifecycle(t *testing.T) {
	game := &Game{}
	engine.Run(game.Hooks())
	engine.FixtureStart()
	defer engine.FixtureStop()
	game.mount(assets.LevelFirst)
	engine.FixtureFrame(engine.Frame{Number: 1, Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(game.level.request), Handle: 9}}})
	if !game.flight.playing || game.flight.shape == nil {
		t.Fatal("flight did not start")
	}
	change := func(frame uint64, element uint32, value string) {
		engine.FixtureFrame(engine.Frame{Number: frame, Events: []engine.InputEvent{{Type: engine.EventUIChange, Instance: engine.FixtureUIID(), Element: element, UIValue: value}}})
	}
	change(2, config.FlightTabs, "2")
	change(3, config.FlightName, "Aster")
	change(4, config.FlightPower, "75")
	change(5, config.FlightShip, "2")
	if game.flight.settings.CallSign != "Aster" || game.flight.settings.Power != 75 || game.flight.settings.Ship != 2 || game.flight.settings.Tab != 2 {
		t.Fatal("widget values did not reach persistent model", game.flight.settings)
	}
	x := game.flight.shape.Position().X
	engine.FixtureFrame(engine.Frame{Number: 6})
	if game.flight.shape.Position().X-x != 4.5 {
		t.Fatal("ship and power did not affect flight")
	}
	change(7, config.FlightAutopilot, "false")
	x = game.flight.shape.Position().X
	engine.FixtureFrame(engine.Frame{Number: 8})
	if game.flight.shape.Position().X != x {
		t.Fatal("disabled autopilot still moves")
	}
	if len(engine.FixtureCommands()) != 24 {
		t.Fatal("idle console projected commands")
	}
	game.deliver()
	if game.flight.deliveries != 1 {
		t.Fatal("delivery did not update game state")
	}
	engine.FixtureFrame(engine.Frame{Number: 9, Events: []engine.InputEvent{{Type: engine.EventKeyDown, Key: engine.KeyEscape}}})
	if game.flight.playing {
		t.Fatal("Escape did not pause")
	}
	game.resume()
	engine.FixtureFrame(engine.Frame{Number: 10})
	if game.flight.settings.CallSign != "Aster" || game.flight.settings.Tab != 2 || game.flight.settings.Autopilot {
		t.Fatal("resume reset flight preferences")
	}
	game.leave()
	game.levelReleased(engine.LevelReleased{RequestID: game.level.release, Handle: 10})
	if game.level.handle != 9 {
		t.Fatal("unrelated release cleared live level")
	}
	engine.FixtureFrame(engine.Frame{Number: 11, Events: []engine.InputEvent{{Type: engine.EventLevelReleased, RequestID: uint32(game.level.release), Handle: 9}}})
	if game.level.handle != 0 || game.flight.shape != nil || game.flight.playing {
		t.Fatal("release retained flight")
	}
	game.mount(assets.LevelSecond)
	engine.FixtureFrame(engine.Frame{Number: 12, Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(game.level.request), Handle: 19}}})
	if !game.flight.playing || game.flight.settings.CallSign != "Aster" || game.flight.settings.Ship != 2 {
		t.Fatal("new arena reset pilot preferences")
	}
}
