package main

import (
	"encoding/binary"
	"math"
	"testing"

	"example.com/environment/.karty/engine"
)

func TestEnvironmentWalkingRetainsGravityAndStops(t *testing.T) {
	engine.FixtureBegin()
	game := &engine.Game{}
	camera := game.NewCamera3D(1, engine.CameraSettings{
		Projection: engine.CameraProjectionPerspective, Output: engine.CameraOutputFull,
		Position: engine.NewVec3(0, 32, 4), FOVY: 1, Near: .05, Far: 120,
		OrthoHeight: 60, ViewportWidth: 1280, ViewportHeight: 720,
	})
	controller := NewFPSController(game)
	world:=game.World(1)
 if err:=world.Configure(engine.WorldSettings{Mode:engine.WorldSpatial,Gravity:engine.Vec3{Z:-9.81}});err!=nil{t.Fatal(err)}
 settings:=engine.DynamicBox();settings.Collider=engine.BoxCollider{HalfExtents:engine.Vec3{X:.3,Y:.3,Z:.85},Offset:engine.Vec3{Z:-.85}};settings.Mass=80;settings.Rotate=false
 body,err:=world.AttachBody(camera.Ref(),settings);if err!=nil{t.Fatal(err)}
 controller.SetCamera(camera,body)
	for _, sample := range []struct {
		name   string
		keys   []engine.Key
		vx, vy float32
		look   bool
	}{
		{name: "idle"},
		{name: "walk while falling", keys: []engine.Key{engine.KeyW}, vy: 3.3},
		{name: "run while falling", keys: []engine.Key{engine.KeyW, engine.KeyShiftLeft}, vy: 6.6},
		{name: "strafe", keys: []engine.Key{engine.KeyD}, vx: 3.3},
		{name: "stop"},
		{name: "look while falling", keys: []engine.Key{engine.KeyRight}, look: true},
	} {
		t.Run(sample.name, func(t *testing.T) {
			controller.Reset()
			camera.Settings.Position.Z -= .2 // A newly accepted falling pose from the host.
			camera.Settings.Yaw, camera.Settings.Pitch = 0, 0
			before := camera.Settings.Position
			for _, key := range sample.keys {
				controller.Key(key, true)
			}
			engine.FixtureBegin()
			controller.Update(engine.Frame{})
			checkEnvironmentMovement(t, engine.FixtureCommands(), camera.ID, sample.vx, sample.vy, sample.look)
			if camera.Settings.Position != before {
				t.Fatal("walking or looking teleported the falling player")
			}
		})
	}
}

func checkEnvironmentMovement(t *testing.T, commands []byte, id uint32, vx, vy float32, cameraUpdate bool) {
	t.Helper()
	wantCount := uint32(1)
	if cameraUpdate {
		wantCount++
	}
	if binary.LittleEndian.Uint32(commands[16:20]) != wantCount {
		t.Fatalf("unexpected controller commands: %v", commands)
	}
	offset := 24
	if cameraUpdate {
		if commands[offset] != 28 {
			t.Fatalf("expected camera settings before velocity: %v", commands)
		}
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	if commands[offset] != 45 || binary.LittleEndian.Uint16(commands[offset+1:offset+3]) != 20 || binary.LittleEndian.Uint32(commands[offset+3:offset+7]) != id {
		t.Fatalf("expected horizontal physics command: %v", commands)
	}
	payload := commands[offset+3:]
	for index, want := range [...]float32{vx, vy, 0} {
		got := math.Float32frombits(binary.LittleEndian.Uint32(payload[4+index*4 : 8+index*4]))
		if math.Abs(float64(got-want)) > .00001 {
			t.Fatalf("velocity axis %d: got %v want %v", index, got, want)
		}
	}
	if binary.LittleEndian.Uint32(payload[16:20]) != 1 {
		t.Fatal("movement no longer preserves vertical velocity")
	}
}
