func TestCameraAndControlsUseConfiguredCanvas(t *testing.T) {
	engine.FixtureBegin()
	t.Cleanup(engine.FixtureStop)
	game := &Game{}
	game.start()
	(engine.Hooks{}).Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9}}})

	if width != float32(config.ResolutionWidth) || height != float32(config.ResolutionHeight) {
		t.Fatalf("control canvas %gx%g differs from configured %dx%d", width, height,
			config.ResolutionWidth, config.ResolutionHeight)
	}

	settings := game.player.camera.Settings()
	if settings.ViewportWidth != config.ResolutionWidth || settings.ViewportHeight != config.ResolutionHeight {
		t.Fatalf("camera viewport %dx%d differs from configured %dx%d", settings.ViewportWidth, settings.ViewportHeight,
			config.ResolutionWidth, config.ResolutionHeight)
	}

	if settings.VerticalFOV != config.CameraFOVY || settings.OrthoHeight != config.CameraOrthoHeight ||
		settings.NearClip != config.CameraNear || settings.FarClip != config.CameraFar {
		t.Fatalf("camera ignores authored project settings: %+v", settings)
	}
}

func TestImpactDetectionRejectsGravityLaunchesAndSettling(t *testing.T) {
	for _, test := range []struct {
		name          string
		before, after engine.Vec3
		impact        bool
	}{
		{"ground", engine.NewVec3(0, 0, -5), engine.Vec3{}, true},
		{"wall", engine.NewVec3(5, 0, 0), engine.Vec3{}, true},
		{"bounce", engine.NewVec3(0, -4, 0), engine.NewVec3(0, 1, 0), true},
		{"gravity", engine.NewVec3(0, 0, -5), engine.NewVec3(0, 0, -5-9.81/60), false},
		{"launch", engine.NewVec3(0, 0, -1), engine.NewVec3(0, 0, -6), false},
		{"settling", engine.NewVec3(.1, -.1, .1), engine.Vec3{}, false},
	} {
		t.Run(test.name, func(t *testing.T) {
			if got := impactSpeed(test.before, test.after) >= 1.25; got != test.impact {
				t.Fatalf("impact=%v, want %v", got, test.impact)
			}
		})
	}
}

func TestFallingStackAudioIsBoundedAndSettlesToSilence(t *testing.T) {
	engine.FixtureBegin()
	t.Cleanup(engine.FixtureStop)
	game := &Game{}
	game.start()
	(engine.Hooks{}).Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9}}})
	setHeight := func(z float32) {
		for _, crate := range game.crates.crates {
			pose := crate.Transform()
			pose.Position.Z = z
			engine.FixtureAcceptedPose(uint32(crate.ID()), pose)
		}
	}
	setHeight(3)
	game.audio.reset(&game.crates)
	for range 46 {
		game.update(engine.Frame{})
	}
	engine.FixtureAudioReset()
	setHeight(2.9)
	game.update(engine.Frame{})
	if len(engine.FixtureAudioCalls()) != 0 {
		t.Fatal("falling crates played an impact before contact")
	}
	setHeight(2.8)
	game.update(engine.Frame{})
	game.update(engine.Frame{}) // stopped on the surface
	calls := engine.FixtureAudioCalls()
	if len(calls) != 1 || calls[0].Sound != uint32(assets.SoundCrateHit) || calls[0].Z != 2.8 {
		t.Fatalf("80 simultaneous contacts must yield one XYZ impact: %+v", calls)
	}
	for range 60 {
		game.update(engine.Frame{})
	}
	if len(engine.FixtureAudioCalls()) != 1 {
		t.Fatal("resting crates continued playing")
	}
}

func TestBlastHitCorrelationParticleBudgetAndReset(t *testing.T) {
	engine.FixtureBegin()
	t.Cleanup(engine.FixtureStop)
	game := &Game{}
	game.start()
	(engine.Hooks{}).Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9}}})
	engine.FixtureAudioReset()
	for range 6 {
		game.fire(true)
		request := game.player.gun.pending[0]
		if request == 0 {
			t.Fatal("blast did not request a hit")
		}
		result := engine.RaycastResult{RequestID: request, Handle: game.level, Hit: true,
			Position: engine.NewVec3(1, 2, 3), Normal: engine.NewVec3(0, 0, 1)}
		game.blastHit(result)
		game.blastHit(result) // duplicate responses must not restart effects
	}
	if len(engine.FixtureAudioCalls()) != 4 {
		t.Fatal("blast audio exceeded four live/fading voices")
	}
	active := func() int {
		count := 0
		for _, burst := range game.particles.bursts {
			for _, particle := range burst {
				if particle.sprite != nil {
					count++
				}
			}
		}
		return count
	}
	if active() != 24 {
		t.Fatalf("burst replacement exceeded particle budget: %d", active())
	}
	for range 180 {
		game.particles.update(game.level)
	}
	if active() != 0 {
		t.Fatal("expired smoke particles remained alive")
	}
	game.fire(true)
	late := game.player.gun.pending[0]
	game.reset()
	game.blastHit(engine.RaycastResult{RequestID: late, Handle: game.level, Hit: true})
	if active() != 0 {
		t.Fatal("reset replayed a late blast response")
	}
}

func TestHeldFireBlastAndReset(t *testing.T) {
	engine.FixtureBegin()
	t.Cleanup(engine.FixtureStop)
	game := &Game{}
	game.start()
	(engine.Hooks{}).Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9}}})

	hooks := game.Hooks()
	hooks.Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventKeyDown, Key: engine.KeySpace}}})
	for range 8 {
		hooks.Update(engine.Frame{})
	}
	if game.player.gun.shots != 2 {
		t.Fatalf("held fire lost its cooldown: got %d shots, want 2", game.player.gun.shots)
	}

	hooks.Update(engine.Frame{Events: []engine.InputEvent{
		{Type: engine.EventKeyUp, Key: engine.KeySpace},
		{Type: engine.EventKeyDown, Key: engine.KeyB},
	}})
	if game.player.gun.shots != 2 || game.player.gun.blasts != 1 {
		t.Fatalf("blast during cooldown: shots=%d blasts=%d", game.player.gun.shots, game.player.gun.blasts)
	}

	hooks.Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventKeyDown, Key: engine.KeyR}}})
	hooks.Update(engine.Frame{})
	if game.player.gun.shots != 0 || game.player.gun.blasts != 0 {
		t.Fatalf("reset replayed an old action: shots=%d blasts=%d", game.player.gun.shots, game.player.gun.blasts)
	}
}

func TestTouchMoveLookAndThirdFingerFire(t *testing.T) {
	engine.FixtureBegin()
	t.Cleanup(engine.FixtureStop)
	game := &Game{}
	game.start()
	(engine.Hooks{}).Update(engine.Frame{Events: []engine.InputEvent{{Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9}}})
	hooks := game.Hooks()
	touch := func(phase engine.PointerPhase, id uint32, x, y float32) engine.InputEvent {
		return engine.InputEvent{Type: engine.EventPointer, Pointer: engine.PointerInput{
			Kind: engine.PointerTouch, Phase: phase, ID: id, X: x, Y: y,
		}}
	}
	// Crate Room permits gestures above the SDK's default lower-screen region.
	hooks.Update(engine.Frame{Events: []engine.InputEvent{
		touch(engine.PointerDown, 1, 110, height-104),
		touch(engine.PointerDown, 2, width-70, 60),
	}})
	engine.FixtureBegin()
	hooks.Update(engine.Frame{Events: []engine.InputEvent{
		touch(engine.PointerMove, 1, 110, height-164),
		touch(engine.PointerMove, 2, width-60, 55),
		touch(engine.PointerDown, 3, shootX, shootY),
	}})
	if game.player.gun.shots != 1 || math.Abs(float64(game.player.camera.Settings().Yaw-.06)) > .00001 {
		t.Fatalf("third-finger fire interrupted look: shots=%d yaw=%v", game.player.gun.shots, game.player.camera.Settings().Yaw)
	}
	assertWalking := func() {
		t.Helper()
		commands := engine.FixtureCommands()
		for offset := 24; offset < len(commands); {
			payload := commands[offset+3:]
			if commands[offset] == 45 && binary.LittleEndian.Uint32(payload[:4]) == uint32(game.player.camera.ID()) {
				if y := math.Float32frombits(binary.LittleEndian.Uint32(payload[8:12])); y <= 0 {
					t.Fatalf("third-finger action stopped walking: velocity=%v", y)
				}
				return
			}
			offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
		}
		t.Fatal("touch movement submitted no horizontal body velocity")
	}
	assertWalking()
	engine.FixtureBegin()
	hooks.Update(engine.Frame{Events: []engine.InputEvent{touch(engine.PointerUp, 3, shootX, shootY)}})
	assertWalking()
	for range 9 {
		hooks.Update(engine.Frame{})
	}
	if game.player.gun.shots != 1 {
		t.Fatal("releasing the shoot finger left held fire active")
	}
}
