func lightGame(t *testing.T) *Game {
	game := &Game{scene: hangarScene{level: 9}, tour: hangarTour{torchEnabled: true}}
	if err := game.World(9).Configure(engine.WorldSettings{Mode: engine.WorldSpatial, Gravity: engine.Vec3{Z: -9.81}}); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(game.stop)
	game.visit(0)
	return game
}

// Reconstruct the host's camera-basis composition to observe the world beam.
func beamAngles(camera engine.Camera3DSettings, light engine.LightSettings) (float64, float64) {
	sy, cy := math.Sincos(float64(camera.Yaw))
	sp, cp := math.Sincos(float64(camera.Pitch))
	basis := [3][3]float64{{cy, -sy, 0}, {sy * cp, cy * cp, sp}, {-sy * sp, -cy * sp, cp}}
	lsy, lcy := math.Sincos(float64(light.Yaw))
	lsp, lcp := math.Sincos(float64(light.Pitch))
	local := [3]float64{lsy * lcp, lcy * lcp, lsp}
	var world [3]float64
	for axis := range world {
		for index := range local {
			world[axis] += basis[index][axis] * local[index]
		}
	}
	return math.Atan2(world[0], world[1]), math.Atan2(world[2], math.Hypot(world[0], world[1]))
}

func TestTorchQuarterSecondAimAndIdle(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	if game.tour.torch.Settings().Shadows || game.tour.torch.Settings().Color != engine.NewVec3(3, 2.7, 2.16) || game.tour.torch.Settings().InnerHalfAngle != .25 || game.tour.torch.Settings().OuterHalfAngle != .50 {
		t.Fatal("torch tuning changed", game.tour.torch.Settings())
	}
	engine.FixtureCameraSettings(game.tour.camera).Yaw, engine.FixtureCameraSettings(game.tour.camera).Pitch = 0, 0
	game.tour.torchAim = lightAim{}
	offset, parent := game.tour.torch.Settings().Position, game.tour.torch.Settings().Parent
	engine.FixtureCameraSettings(game.tour.camera).Yaw, engine.FixtureCameraSettings(game.tour.camera).Pitch = 1, .6
	for frame := uint64(1); frame <= 15; frame++ {
		game.tour.updateTorch(frame)
	}
	yaw, pitch := beamAngles(game.tour.camera.Settings(), game.tour.torch.Settings())
	if math.Abs(yaw-(1-math.Exp(-1))) > 1e-6 || math.Abs(pitch-(float64(game.tour.camera.Settings().Pitch)*(1-math.Exp(-1)))) > 1e-6 {
		t.Fatal("beam did not ease in world direction over quarter-second", yaw, pitch)
	}
	if game.tour.torch.Settings().Position != offset || game.tour.torch.Settings().Parent != parent {
		t.Fatal("direction smoothing detached or moved the local light")
	}
	before := game.tour.torch.Settings()
	game.tour.updateTorch(15)
	if game.tour.torch.Settings() != before {
		t.Fatal("duplicate update advanced smoothing")
	}
	for frame := uint64(16); frame <= 300; frame++ {
		engine.FixtureBegin()
		game.tour.updateTorch(frame)
	}
	engine.FixtureBegin()
	game.tour.updateTorch(301)
	if game.tour.torch.Settings().Yaw != 0 || game.tour.torch.Settings().Pitch != 0 || binary.LittleEndian.Uint32(engine.FixtureCommands()[16:20]) != 0 {
		t.Fatal("settled beam did not stop emitting commands", game.tour.torch.Settings())
	}
	game.visit(2)
	if game.tour.torch.Settings().Yaw != 0 || game.tour.torch.Settings().Pitch != 0 || game.tour.torchAim.updated {
		t.Fatal("view replacement retained previous aim lag")
	}
	game.stop()
}

func TestTorchYawWrapFrameGapAndAcceptedRotation(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	start := math.Pi - .04
	game.tour.torchAim = lightAim{yaw: start, pitch: .4}
	engine.FixtureCameraSettings(game.tour.camera).Yaw, engine.FixtureCameraSettings(game.tour.camera).Pitch = float32(-math.Pi+.04), .4
	game.tour.updateTorch(1)
	game.tour.updateTorch(16)
	yaw, pitch := beamAngles(game.tour.camera.Settings(), game.tour.torch.Settings())
	target := float64(game.tour.camera.Settings().Yaw)
	expected := start + math.Remainder(target-start, 2*math.Pi)*(1-math.Exp(-16.0/15))
	if math.Abs(math.Remainder(yaw-expected, 2*math.Pi)) > 1e-6 || math.Abs(pitch-.4) > 1e-6 {
		t.Fatal("yaw wrap or elapsed frame gap changed catch-up", yaw, pitch)
	}
	// Accepted camera rotation (for example a portal) carries the existing
	// local beam through the new pose, then smoothing resumes from that aim.
	local := game.tour.torch.Settings()
	pose := engine.NewTransform3D(engine.NewVec3(8, 9, 2))
	pose.Yaw, pose.Pitch = .8, -.5
	engine.FixtureAcceptedPose(uint32(game.tour.camera.ID()), pose)
	game.tour.acceptTorchPose(pose)
	beforeYaw, beforePitch := beamAngles(game.tour.camera.Settings(), local)
	game.tour.updateTorch(17)
	afterYaw, afterPitch := beamAngles(game.tour.camera.Settings(), game.tour.torch.Settings())
	blend := 1 - math.Exp(-1.0/15)
	expectedYaw := beforeYaw + math.Remainder(float64(pose.Yaw)-beforeYaw, 2*math.Pi)*blend
	expectedPitch := beforePitch + (float64(pose.Pitch)-beforePitch)*blend
	if math.Abs(math.Remainder(afterYaw-expectedYaw, 2*math.Pi)) > 1e-6 || math.Abs(afterPitch-expectedPitch) > 1e-6 || game.tour.torch.Settings().Parent != uint32(game.tour.camera.ID()) {
		t.Fatal("accepted rotation lost attached lag", afterYaw, afterPitch)
	}
	if game.tour.camera.Settings().Position != pose.Position || game.tour.torch.Settings().Position != local.Position {
		t.Fatal("accepted movement changed the torch's camera-local offset")
	}
	game.stop()
}

func TestTorchToggleAndCameraReplacement(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	handheldOffset := engine.NewVec3(.35, .20, -.30) // right, forward, up
	if game.tour.torch.Settings().Position != handheldOffset || game.tour.torch.Settings().Parent != uint32(game.tour.camera.ID()) || !game.tour.torch.Settings().Enabled || game.tour.torch.Settings().Shadows || game.tour.torch.Level() != game.scene.level {
		t.Fatal("torch is not attached to its level camera", game.tour.torch)
	}
	game.key(engine.KeyF, true)
	game.key(engine.KeyF, true)
	if game.tour.torchEnabled || game.tour.torch.Settings().Enabled {
		t.Fatal("held F toggled more than once")
	}
	oldCamera, oldTorch := game.tour.camera, game.tour.torch
	game.tour.bolt.launch(&game.Game, game.scene.level, game.tour.camera)
	oldBolt := game.tour.bolt.light
	oldIDs := [...]uint32{uint32(oldBolt.ID()), uint32(oldTorch.ID()), uint32(oldCamera.ID())}
	engine.FixtureBegin()
	game.visit(1)
	if uint32(oldCamera.ID()) != 0 || uint32(oldTorch.ID()) != 0 || uint32(oldBolt.ID()) != 0 || game.tour.bolt.light != nil {
		t.Fatal("old view retained dynamic entities")
	}
	if game.tour.torch.Settings().Position != handheldOffset || game.tour.torch.Settings().Enabled || game.tour.torch.Settings().Shadows || game.tour.torch.Settings().Parent != uint32(game.tour.camera.ID()) {
		t.Fatal("replacement camera lost torch state")
	}
	game.key(engine.KeyF, true)
	if game.tour.torch.Settings().Enabled {
		t.Fatal("view replacement forgot held F")
	}
	game.key(engine.KeyF, false)
	// Destruction must precede creation, and the attached torch must be
	// destroyed before its old camera, so a complete batch has valid parents.
	commands := engine.FixtureCommands()
	if binary.LittleEndian.Uint32(commands[16:20]) < 3 {
		t.Fatal("view replacement did not submit its cleanup batch", commands)
	}
	removed, created := 0, false
	for offset := 24; offset < len(commands); {
		tag := commands[offset]
		payload := commands[offset+3:]
		if tag == 2 {
			id := binary.LittleEndian.Uint32(payload[:4])
			for _, oldID := range oldIDs {
				if id == oldID {
					if removed == len(oldIDs) || id != oldIDs[removed] || created {
						t.Fatal("view replacement removed lights or camera out of order", commands)
					}
					removed++
				}
			}
		}
		if tag == 27 {
			if removed != len(oldIDs) {
				t.Fatal("view replacement created camera before removing its old lights and camera", commands)
			}
			created = true
		}
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	if removed != len(oldIDs) || !created {
		t.Fatal("view replacement omitted camera cleanup or creation", commands)
	}
	game.toggleTorch() // The touch callback shares the keyboard action.
	if !game.tour.torch.Settings().Enabled {
		t.Fatal("touch toggle failed")
	}
	game.stop()
	if game.tour.torch != nil || uint32(game.tour.camera.ID()) != 0 {
		t.Fatal("shutdown retained torch/camera")
	}
}

func TestPointBoltAcceptedPoseMovementReplacementAndFade(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	engine.FixtureCameraSettings(game.tour.camera).Position = engine.NewVec3(7, 8, 2)
	engine.FixtureCameraSettings(game.tour.camera).Yaw = math.Pi / 2
	engine.FixtureCameraSettings(game.tour.camera).Pitch = 0
	game.tour.torchAim = lightAim{yaw: float64(game.tour.camera.Settings().Yaw)}
	game.tour.bolt.launch(&game.Game, game.scene.level, game.tour.camera)
	if game.tour.bolt.light.Settings().Kind != engine.LightPoint || game.tour.bolt.light.Settings().Parent != 0 ||
		math.Abs(float64(game.tour.bolt.position.X)-7.5) > 1e-5 || math.Abs(float64(game.tour.bolt.position.Y)-8) > 1e-5 {
		t.Fatal("bolt did not launch from accepted camera pose", game.tour.bolt)
	}
	old := game.tour.bolt.light
	game.key(engine.KeyG, true)
	game.key(engine.KeyG, true)
	game.update(engine.Frame{Number: 1})
	if old != game.tour.bolt.light || game.tour.bolt.remaining != 90 {
		t.Fatal("paused point-light demo still responds to G or game updates")
	}
	game.tour.bolt.launch(&game.Game, game.scene.level, game.tour.camera) // Retained reusable demo remains directly testable.
	current := game.tour.bolt.light
	if uint32(old.ID()) != 0 || current == old {
		t.Fatal("direct bolt replacement failed")
	}
	position := game.tour.bolt.position
	game.tour.bolt.update()
	if game.tour.bolt.position.X <= position.X || game.tour.bolt.light.Settings().Position != game.tour.bolt.position {
		t.Fatal("point light did not move")
	}
	for frame := uint64(2); frame <= 71; frame++ {
		game.tour.bolt.update()
	}
	if game.tour.bolt.light.Settings().Color.X >= 4 {
		t.Fatal("bolt did not fade")
	}
	for frame := uint64(72); frame <= 90; frame++ {
		game.tour.bolt.update()
	}
	if game.tour.bolt.light != nil || uint32(current.ID()) != 0 {
		t.Fatal("expired bolt leaked")
	}
	engine.FixtureBegin()
	game.Hooks().Update(engine.Frame{Number: 91})
	commands := engine.FixtureCommands()
	// Idle locomotion explicitly stops horizontal motion without emitting any
	// light updates. This also keeps gravity active after input is released.
	checkControllerCommands(t, commands, uint32(game.tour.camera.ID()), 0, 0, false)
	game.stop()
}

func checkControllerCommands(t *testing.T, commands []byte, id uint32, vx, vy float32, cameraUpdate bool) {
	t.Helper()
	wantCount := uint32(1)
	offset := 24

	if cameraUpdate {
		wantCount++
	}
	end := offset
	for end < len(commands) {
		if commands[end] == 54 {
			wantCount++
			if end+3+int(binary.LittleEndian.Uint16(commands[end+1:end+3])) != len(commands) {
				t.Fatal("elevator must update after movement", commands)
			}
		}
		end += 3 + int(binary.LittleEndian.Uint16(commands[end+1:end+3]))
	}
	if binary.LittleEndian.Uint32(commands[16:20]) != wantCount {
		t.Fatalf("unexpected controller commands: %v", commands)
	}
	if cameraUpdate {
		if commands[offset] != 28 {
			t.Fatalf("expected camera settings before velocity: %v", commands)
		}
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	if commands[offset] != 45 || binary.LittleEndian.Uint16(commands[offset+1:offset+3]) != 20 || binary.LittleEndian.Uint32(commands[offset+3:offset+7]) != id {
		t.Fatalf("expected horizontal physics command: %v", commands)
	}
	payload := commands[offset+3:]
	for index, want := range [...]float32{vx, vy, 0} {
		got := math.Float32frombits(binary.LittleEndian.Uint32(payload[4+index*4 : 8+index*4]))
		if math.Abs(float64(got-want)) > .00001 {
			t.Fatalf("velocity axis %d: got %v want %v", index, got, want)
		}
	}
	if binary.LittleEndian.Uint32(payload[16:20]) != 1 {
		t.Fatal("movement no longer preserves vertical velocity")
	}
}

func TestControllerUsesPhysicsVelocityForWalkLookStopAndDescent(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	defer game.stop()
	input := &controllerFrames{}
	settings := game.tour.camera.Settings()
	settings.Position, settings.Yaw, settings.Pitch = engine.NewVec3(9, -4, 1.7), 0, 0
	*engine.FixtureCameraSettings(game.tour.camera) = settings // Host-accepted pose, with no new command.
	input.key(engine.KeyW, true)
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 0, 3.3, false)
	if game.tour.camera.Settings().Position != settings.Position {
		t.Fatal("flat walking teleported the player")
	}
	input.key(engine.KeyShiftLeft, true)
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 0, 6.6, false)
	input.key(engine.KeyW, false)
	input.key(engine.KeyShiftLeft, false)
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 0, 0, false)
	input.key(engine.KeyRight, true)
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 0, 0, true)
	if game.tour.camera.Settings().Position != settings.Position || game.tour.camera.Settings().Yaw == settings.Yaw {
		t.Fatal("looking changed position or failed to turn")
	}
	game.tour.controller.Reset()
	input.key(engine.KeyW, true)
	settings = game.tour.camera.Settings()
	settings.Position, settings.Yaw = engine.NewVec3(-5.7, 22, 2.9), math.Pi/2
	*engine.FixtureCameraSettings(game.tour.camera) = settings
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 3.3, 0, false)
	if game.tour.camera.Settings().Position != settings.Position {
		t.Fatal("descending a stair snapped position")
	}
	game.tour.controller.Reset()
	engine.FixtureBegin()
	input.update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), uint32(game.tour.camera.ID()), 0, 0, false)
}

func TestTouchTorchButtonThroughGeneratedUI(t *testing.T) {
	game := &Game{}
	engine.Run(game.Hooks())
	engine.FixtureStart()
	defer engine.FixtureStop()
	engine.FixtureFrame(engine.Frame{Number: 1, Events: []engine.InputEvent{{
		Type: engine.EventLevelReady, RequestID: uint32(engine.FixtureLastLevelRequest()), Handle: 9,
	}}})
	click := func(frame uint64, element uint32) {
		engine.FixtureFrame(engine.Frame{Number: frame, Events: []engine.InputEvent{{
			Type: engine.EventUIAction, Instance: engine.FixtureUIID(), Element: element,
		}}})
	}
	click(2, config.TorchButton)
	if game.tour.torchEnabled || game.tour.torch.Settings().Enabled {
		t.Fatal("generated touch button did not disable torch")
	}
	click(3, config.TorchButton)
	if !game.tour.torchEnabled || !game.tour.torch.Settings().Enabled {
		t.Fatal("generated touch button did not reenable torch")
	}
	engine.FixtureFrame(engine.Frame{Number: 4, Events: []engine.InputEvent{{Type: engine.EventKeyDown, Key: engine.KeyG}}})
	if game.tour.bolt.light != nil {
		t.Fatal("G launched the paused point-light demo")
	}
}

// Queue real input events, then let the SDK's Hooks.Update own movement dispatch.
type controllerFrames struct{ events []engine.InputEvent }

func (input *controllerFrames) key(key engine.Key, down bool) {
	kind := engine.EventKeyUp
	if down {
		kind = engine.EventKeyDown
	}
	input.events = append(input.events, engine.InputEvent{Type: kind, Key: key})
}

func (input *controllerFrames) update(frame engine.Frame) {
	frame.Events = append(frame.Events, input.events...)
	input.events = input.events[:0]
	(engine.Hooks{}).Update(frame)
}
