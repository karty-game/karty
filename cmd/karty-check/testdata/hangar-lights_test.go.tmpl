func lightGame(t *testing.T) *Game {
	game := &Game{level: 9, torchEnabled: true}
 if err:=game.World(9).Configure(engine.WorldSettings{Mode:engine.WorldSpatial,Gravity:engine.Vec3{Z:-9.81}});err!=nil{t.Fatal(err)}
 t.Cleanup(game.stop)
	game.fps = NewFPSController(&game.Game)
	game.visit(0)
	return game
}

// Reconstruct the host's camera-basis composition to observe the world beam.
func beamAngles(camera engine.CameraSettings, light engine.LightSettings) (float64, float64) {
	sy, cy := math.Sincos(float64(camera.Yaw))
	sp, cp := math.Sincos(float64(camera.Pitch))
	basis := [3][3]float64{{cy, -sy, 0}, {sy * cp, cy * cp, sp}, {-sy * sp, -cy * sp, cp}}
	lsy, lcy := math.Sincos(float64(light.Yaw))
	lsp, lcp := math.Sincos(float64(light.Pitch))
	local := [3]float64{lsy * lcp, lcy * lcp, lsp}
	var world [3]float64
	for axis := range world {
		for index := range local {
			world[axis] += basis[index][axis] * local[index]
		}
	}
	return math.Atan2(world[0], world[1]), math.Atan2(world[2], math.Hypot(world[0], world[1]))
}

func TestTorchQuarterSecondAimAndIdle(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	if game.torch.Settings.Shadows || game.torch.Settings.Color != engine.NewVec3(3, 2.7, 2.16) || game.torch.Settings.InnerAngle != .25 || game.torch.Settings.OuterAngle != .50 {
		t.Fatal("torch tuning changed", game.torch.Settings)
	}
	game.camera.Settings.Yaw, game.camera.Settings.Pitch = 0, 0
	game.torchAim = lightAim{}
	offset, parent := game.torch.Settings.Position, game.torch.Settings.Parent
	game.camera.Settings.Yaw, game.camera.Settings.Pitch = 1, .6
	for frame := uint64(1); frame <= 15; frame++ {
		game.updateTorch(frame)
	}
	yaw, pitch := beamAngles(game.camera.Settings, game.torch.Settings)
	if math.Abs(yaw-(1-math.Exp(-1))) > 1e-6 || math.Abs(pitch-(float64(game.camera.Settings.Pitch)*(1-math.Exp(-1)))) > 1e-6 {
		t.Fatal("beam did not ease in world direction over quarter-second", yaw, pitch)
	}
	if game.torch.Settings.Position != offset || game.torch.Settings.Parent != parent {
		t.Fatal("direction smoothing detached or moved the local light")
	}
	before := game.torch.Settings
	game.updateTorch(15)
	if game.torch.Settings != before {
		t.Fatal("duplicate update advanced smoothing")
	}
	for frame := uint64(16); frame <= 300; frame++ {
		engine.FixtureBegin()
		game.updateTorch(frame)
	}
	engine.FixtureBegin()
	game.updateTorch(301)
	if game.torch.Settings.Yaw != 0 || game.torch.Settings.Pitch != 0 || binary.LittleEndian.Uint32(engine.FixtureCommands()[16:20]) != 0 {
		t.Fatal("settled beam did not stop emitting commands", game.torch.Settings)
	}
	game.visit(2)
	if game.torch.Settings.Yaw != 0 || game.torch.Settings.Pitch != 0 || game.torchAim.updated {
		t.Fatal("view replacement retained previous aim lag")
	}
	game.stop()
}

func TestTorchYawWrapFrameGapAndAcceptedRotation(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	start := math.Pi - .04
	game.torchAim = lightAim{yaw: start, pitch: .4}
	game.camera.Settings.Yaw, game.camera.Settings.Pitch = float32(-math.Pi+.04), .4
	game.updateTorch(1)
	game.updateTorch(16)
	yaw, pitch := beamAngles(game.camera.Settings, game.torch.Settings)
	target := float64(game.camera.Settings.Yaw)
	expected := start + math.Remainder(target-start, 2*math.Pi)*(1-math.Exp(-16.0/15))
	if math.Abs(math.Remainder(yaw-expected, 2*math.Pi)) > 1e-6 || math.Abs(pitch-.4) > 1e-6 {
		t.Fatal("yaw wrap or elapsed frame gap changed catch-up", yaw, pitch)
	}
	// Accepted camera rotation (for example a portal) carries the existing
	// local beam through the new pose, then smoothing resumes from that aim.
	local := game.torch.Settings
	pose := engine.NewTransform3D(engine.NewVec3(8, 9, 2))
	pose.Yaw, pose.Pitch = .8, -.5
	engine.FixtureAcceptedPose(game.camera.ID,pose)
	game.acceptTorchPose(pose)
	beforeYaw, beforePitch := beamAngles(game.camera.Settings, local)
	game.updateTorch(17)
	afterYaw, afterPitch := beamAngles(game.camera.Settings, game.torch.Settings)
	blend := 1 - math.Exp(-1.0/15)
	expectedYaw := beforeYaw + math.Remainder(float64(pose.Yaw)-beforeYaw, 2*math.Pi)*blend
	expectedPitch := beforePitch + (float64(pose.Pitch)-beforePitch)*blend
	if math.Abs(math.Remainder(afterYaw-expectedYaw, 2*math.Pi)) > 1e-6 || math.Abs(afterPitch-expectedPitch) > 1e-6 || game.torch.Settings.Parent != game.camera.ID {
		t.Fatal("accepted rotation lost attached lag", afterYaw, afterPitch)
	}
	if game.camera.Settings.Position != pose.Position || game.torch.Settings.Position != local.Position {
		t.Fatal("accepted movement changed the torch's camera-local offset")
	}
	game.stop()
}

func TestTorchToggleAndCameraReplacement(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	handheldOffset := engine.NewVec3(.35, .20, -.30) // right, forward, up
	if game.torch.Settings.Position != handheldOffset || game.torch.Settings.Parent != game.camera.ID || !game.torch.Settings.Enabled || game.torch.Settings.Shadows || game.torch.World != game.level {
		t.Fatal("torch is not attached to its level camera", game.torch)
	}
	game.key(engine.KeyF, true)
	game.key(engine.KeyF, true)
	if game.torchEnabled || game.torch.Settings.Enabled {
		t.Fatal("held F toggled more than once")
	}
	oldCamera, oldTorch := game.camera, game.torch
	game.launchLight()
	oldBolt := game.bolt.light
	oldIDs := [...]uint32{oldBolt.ID, oldTorch.ID, oldCamera.ID}
	engine.FixtureBegin()
	game.visit(1)
	if oldCamera.ID != 0 || oldTorch.ID != 0 || oldBolt.ID != 0 || game.bolt.light != nil {
		t.Fatal("old view retained dynamic entities")
	}
	if game.torch.Settings.Position != handheldOffset || game.torch.Settings.Enabled || game.torch.Settings.Shadows || game.torch.Settings.Parent != game.camera.ID {
		t.Fatal("replacement camera lost torch state")
	}
	game.key(engine.KeyF, true)
	if game.torch.Settings.Enabled {
		t.Fatal("view replacement forgot held F")
	}
	game.key(engine.KeyF, false)
	// Destruction must precede creation, and the attached torch must be
	// destroyed before its old camera, so a complete batch has valid parents.
	commands := engine.FixtureCommands()
	if binary.LittleEndian.Uint32(commands[16:20]) < 3 {
		t.Fatal("view replacement did not submit its cleanup batch", commands)
	}
	for offset, index := 24, 0; offset < len(commands) && index < 3; index++ {
		if commands[offset] != 2 || binary.LittleEndian.Uint32(commands[offset+3:offset+7]) != oldIDs[index] {
			t.Fatal("view replacement did not remove lights before camera creation", commands)
		}
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	game.toggleTorch() // The touch callback shares the keyboard action.
	if !game.torch.Settings.Enabled {
		t.Fatal("touch toggle failed")
	}
	game.stop()
	if game.torch != nil || game.camera.ID != 0 {
		t.Fatal("shutdown retained torch/camera")
	}
}

func TestPointBoltAcceptedPoseMovementReplacementAndFade(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	game.camera.Settings.Position = engine.NewVec3(7, 8, 2)
	game.camera.Settings.Yaw = math.Pi / 2
	game.camera.Settings.Pitch = 0
	game.torchAim = lightAim{yaw: float64(game.camera.Settings.Yaw)}
	game.launchLight()
	if game.bolt.light.Settings.Kind != engine.LightPoint || game.bolt.light.Settings.Parent != 0 ||
		math.Abs(float64(game.bolt.position.X)-7.5) > 1e-5 || math.Abs(float64(game.bolt.position.Y)-8) > 1e-5 {
		t.Fatal("bolt did not launch from accepted camera pose", game.bolt)
	}
	old := game.bolt.light
	game.key(engine.KeyG, true)
	game.key(engine.KeyG, true)
	game.update(engine.Frame{Number: 1})
	if old != game.bolt.light || game.bolt.remaining != 90 {
		t.Fatal("paused point-light demo still responds to G or game updates")
	}
	game.launchLight() // Retained reusable demo remains directly testable.
	current := game.bolt.light
	if old.ID != 0 || current == old {
		t.Fatal("direct bolt replacement failed")
	}
	position := game.bolt.position
	game.bolt.update()
	if game.bolt.position.X <= position.X || game.bolt.light.Settings.Position != game.bolt.position {
		t.Fatal("point light did not move")
	}
	for frame := uint64(2); frame <= 71; frame++ {
		game.bolt.update()
	}
	if game.bolt.light.Settings.Color.X >= 4 {
		t.Fatal("bolt did not fade")
	}
	for frame := uint64(72); frame <= 90; frame++ {
		game.bolt.update()
	}
	if game.bolt.light != nil || current.ID != 0 {
		t.Fatal("expired bolt leaked")
	}
	engine.FixtureBegin()
	game.update(engine.Frame{Number: 91})
	commands := engine.FixtureCommands()
	// Idle locomotion explicitly stops horizontal motion without emitting any
	// light updates. This also keeps gravity active after input is released.
	checkControllerCommands(t, commands, game.camera.ID, 0, 0, false)
	game.stop()
}

func checkControllerCommands(t *testing.T, commands []byte, id uint32, vx, vy float32, cameraUpdate bool) {
	t.Helper()
	wantCount := uint32(1)
	offset := 24
	// Whole-game updates also animate the independent sector floor.
	if len(commands) > offset && commands[offset] == 54 {
		wantCount++
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	if cameraUpdate {
		wantCount++
	}
	if binary.LittleEndian.Uint32(commands[16:20]) != wantCount {
		t.Fatalf("unexpected controller commands: %v", commands)
	}
	if cameraUpdate {
		if commands[offset] != 28 {
			t.Fatalf("expected camera settings before velocity: %v", commands)
		}
		offset += 3 + int(binary.LittleEndian.Uint16(commands[offset+1:offset+3]))
	}
	if commands[offset] != 45 || binary.LittleEndian.Uint16(commands[offset+1:offset+3]) != 20 || binary.LittleEndian.Uint32(commands[offset+3:offset+7]) != id {
		t.Fatalf("expected horizontal physics command: %v", commands)
	}
	payload := commands[offset+3:]
	for index, want := range [...]float32{vx, vy, 0} {
		got := math.Float32frombits(binary.LittleEndian.Uint32(payload[4+index*4 : 8+index*4]))
		if math.Abs(float64(got-want)) > .00001 {
			t.Fatalf("velocity axis %d: got %v want %v", index, got, want)
		}
	}
	if binary.LittleEndian.Uint32(payload[16:20]) != 1 {
		t.Fatal("movement no longer preserves vertical velocity")
	}
}

func TestControllerUsesPhysicsVelocityForWalkLookStopAndDescent(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	defer game.stop()
	controller := game.fps
	settings := game.camera.Settings
	settings.Position, settings.Yaw, settings.Pitch = engine.NewVec3(9, -4, 1.7), 0, 0
	game.camera.Settings = settings // Host-accepted pose, with no new command.
	controller.Key(engine.KeyW, true)
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 0, 3.3, false)
	if game.camera.Settings.Position != settings.Position {
		t.Fatal("flat walking teleported the player")
	}
	controller.Key(engine.KeyShiftLeft, true)
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 0, 6.6, false)
	controller.Key(engine.KeyW, false)
	controller.Key(engine.KeyShiftLeft, false)
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 0, 0, false)
	controller.Key(engine.KeyRight, true)
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 0, 0, true)
	if game.camera.Settings.Position != settings.Position || game.camera.Settings.Yaw == settings.Yaw {
		t.Fatal("looking changed position or failed to turn")
	}
	controller.Reset()
	controller.Key(engine.KeyW, true)
	settings = game.camera.Settings
	settings.Position, settings.Yaw = engine.NewVec3(-5.7, 22, 2.9), math.Pi/2
	game.camera.Settings = settings
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 3.3, 0, false)
	if game.camera.Settings.Position != settings.Position {
		t.Fatal("descending a stair snapped position")
	}
	controller.Reset()
	engine.FixtureBegin()
	controller.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, 0, 0, false)
}

func TestControllerOnlyLiftsGroundedStairsAtCurrentXY(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	defer game.stop()
	settings := game.camera.Settings
	settings.Position, settings.Yaw, settings.Pitch = engine.NewVec3(46.32, 13.8, 1.9), -math.Pi/2, 0
	game.camera.Settings = settings
	game.fps.Key(engine.KeyW, true)
	engine.FixtureBegin()
	game.fps.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, true)
	position := game.camera.Settings.Position
	if position.X != settings.Position.X || position.Y != settings.Position.Y || math.Abs(float64(position.Z-2.25)) > .00001 {
		t.Fatalf("stair lift moved horizontally or changed wrong height: %v", position)
	}
	settings.Position.Z = 2.04 // Above support but below the next tread's standing height.
	game.camera.Settings = settings
	engine.FixtureBegin()
	game.fps.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, false)
	if game.camera.Settings.Position != settings.Position {
		t.Fatal("airborne movement teleported toward a stair")
	}
}

func TestControllerResetAndCameraChangeClearTransfer(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	defer game.stop()
	for _, cameraChange := range []bool{false, true} {
		settings := game.camera.Settings
		settings.Position, settings.Yaw, settings.Pitch = engine.NewVec3(46.32, 13.8, 1.9), -math.Pi/2, 0
		game.camera.Settings = settings
		game.fps.Key(engine.KeyW, true)
		engine.FixtureBegin()
		game.fps.Update(engine.Frame{})
		settings = game.camera.Settings
		settings.Position.X, settings.Position.Z = 46.265, 2.20 // Accepted progress plus edge settling.
		game.camera.Settings = settings
		engine.FixtureBegin()
		game.fps.Update(engine.Frame{})
		checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, true)
		if cameraChange {
			game.fps.SetCamera(game.camera,game.fps.body)
		} else {
			game.fps.Reset()
		}
		game.fps.Key(engine.KeyW, true)
		game.camera.Settings = settings
		engine.FixtureBegin()
		game.fps.Update(engine.Frame{})
		checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, false)
		if game.camera.Settings.Position != settings.Position {
			t.Fatal("reset retained a provisional transfer lift")
		}
	}
}

func TestControllerGravitySettlingEmitsNoPositionCommand(t *testing.T) {
	engine.FixtureBegin()
	game := lightGame(t)
	defer game.stop()
	settings := game.camera.Settings
	settings.Position, settings.Yaw, settings.Pitch = engine.NewVec3(.32, 22, 1.7), -math.Pi/2, 0
	game.camera.Settings = settings
	game.fps.Key(engine.KeyW, true)
	engine.FixtureBegin()
	game.fps.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, true)
	settings = game.camera.Settings
	settings.Position = engine.NewVec3(-.4, 22, 2.04) // Full footprint on first tread; gap still settling.
	game.camera.Settings = settings
	engine.FixtureBegin()
	game.fps.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, false)
	if game.camera.Settings.Position != settings.Position {
		t.Fatal("full-support settling teleported or froze gravity")
	}
	settings.Position = engine.NewVec3(-.68, 22, 2.02)
	game.camera.Settings = settings
	engine.FixtureBegin()
	game.fps.Update(engine.Frame{})
	checkControllerCommands(t, engine.FixtureCommands(), game.camera.ID, -3.3, 0, true)
	if game.camera.Settings.Position.X != settings.Position.X || math.Abs(float64(game.camera.Settings.Position.Z-2.25)) > .00001 {
		t.Fatal("settling witness did not allow next true riser at current XY")
	}
}

