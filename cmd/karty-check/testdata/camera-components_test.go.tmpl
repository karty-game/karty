func commandCount() uint32 { return binary.LittleEndian.Uint32(engine.FixtureCommands()[16:20]) }
func controllerFixture() cameraController {
	var game engine.Game
	fps := perspectiveCamera(0)
	orbit := isometricCamera(.9)
	return cameraController{camera: game.NewCamera3D(9, fps), orbitCamera: game.NewCamera3D(9, orbit), fps: fps, orbitPose: orbit, orbit: .9, output: engine.CameraOutputFull}
}
func TestIdleAndStoppedMovement(t *testing.T) {
	engine.FixtureBegin()
	controller := controllerFixture()
	engine.FixtureBegin()
	controller.Update()
	if count := commandCount(); count != 0 {
		t.Fatal("idle movement emitted commands", count)
	}
	controller.forward, controller.strafeRight, controller.orbitLeft = true, true, true
	controller.touchMove, controller.touchStrafe, controller.touchOrbit, controller.touchPitch = 1, 1, 1, 1
	controller.Stop()
	engine.FixtureBegin()
	controller.Update()
	if count := commandCount(); count != 0 {
		t.Fatal("stopped input remained active", count)
	}
	controller.right = true
	controller.path = controller.routeEnd()
	engine.FixtureBegin()
	controller.Update()
	if count := commandCount(); count != 0 {
		t.Fatal("clamped tour emitted an unchanged camera", count)
	}
}
func TestWalkNormalizationAndOrbitIsolation(t *testing.T) {
	settings := perspectiveCamera(0)
	settings.Position = engine.NewVec3(0, 0, 2)
	settings.Yaw = 0
	next := walkingCamera(settings, 1, 1)
	if distance := math.Hypot(float64(next.Position.X), float64(next.Position.Y)); math.Abs(distance-.04) > 1e-6 || next.Position.Z != 2 {
		t.Fatal("diagonal speed/height", next)
	}
	engine.FixtureBegin()
	controller := controllerFixture()
	before := controller.fps
	controller.isometric = true
	controller.orbitLeft = true
	engine.FixtureBegin()
	controller.Update()
	if count := commandCount(); count != 1 || controller.fps != before || controller.orbitCamera.Settings().Yaw >= .9 {
		t.Fatal("orbit changed the FPS baseline", count, controller)
	}
}
func TestAcceptedPoseDrivesMarkerAndHUD(t *testing.T) {
	engine.FixtureBegin()
	controller := controllerFixture()
	var hud cameraHUD
	var follower markerFollower
	follower.Bind(engine.FixtureEntityRef(1000010,9))
	controller.onMoved = func(pose engine.Transform3D) { follower.Follow(pose); hud.Refresh(&controller) }
	if !hud.Refresh(&controller) {
		t.Fatal("initial HUD missing")
	}
	controller.forward = true
	engine.FixtureBegin()
	controller.Update()
	if hud.Refresh(&controller) {
		t.Fatal("HUD published a proposed, unaccepted movement")
	}
	accepted := engine.NewTransform3D(engine.NewVec3(7, 2, 3))
	accepted.Yaw = math.Pi / 2
	accepted.Pitch = math.Pi / 6
	engine.FixtureAcceptedPose(uint32(controller.camera.ID()),accepted)
	engine.FixtureBegin()
	controller.OnTransformChanged(accepted)
	commands := engine.FixtureCommands()
	if controller.fps.Position != accepted.Position || !strings.Contains(hud.cameraInfo, "x=7") || binary.LittleEndian.Uint32(commands[16:20]) != 1 || commands[24] != 30 {
		t.Fatal("missing accepted pose reaction", controller.fps, hud.cameraInfo, commands)
	}
	readFloat := func(offset int) float64 {
		return float64(math.Float32frombits(binary.LittleEndian.Uint32(commands[offset : offset+4])))
	}
	if math.Abs(readFloat(31)-(7-.16*math.Cos(math.Pi/6))) > 1e-6 || math.Abs(readFloat(35)-2) > 1e-6 || math.Abs(readFloat(39)-(3-.08)) > 1e-6 {
		t.Fatal("marker did not follow the accepted eye", commands)
	}
	engine.FixtureBegin()
	controller.OnTransformChanged(accepted)
	if count := commandCount(); count != 0 || hud.Refresh(&controller) {
		t.Fatal("identical feedback did work", count)
	}
	controller.isometric = true
	hud.Refresh(&controller)
	controller.onOrbitMoved = func() { hud.Refresh(&controller) }
	engine.FixtureCameraSettings(controller.orbitCamera).Position.X = 12
	engine.FixtureBegin()
	controller.OnOrbitTransformChanged(engine.Transform3D{})
	if count := commandCount(); count != 0 || !strings.Contains(hud.cameraInfo, "ISO\nx=12") || controller.fps.Position != accepted.Position {
		t.Fatal("orbit changed player marker/FPS", count, hud.cameraInfo)
	}
}
func TestDisposedActorsAndFreshBindings(t *testing.T) {
	var follower markerFollower
	var spinner spinnerAnimation
	follower.Bind(engine.FixtureEntityRef(1000010,9))
	spinner.Bind(engine.FixtureEntityRef(1000011,9))
	follower.Reset()
	spinner.Reset()
	engine.FixtureBegin()
	follower.Follow(engine.NewTransform3D(engine.NewVec3(1, 2, 3)))
	spinner.Update(5)
	if count := commandCount(); count != 0 {
		t.Fatal("released actors received commands", count)
	}
	follower.Bind(engine.FixtureEntityRef(1000020,9))
	spinner.Bind(engine.FixtureEntityRef(1000021,9))
	engine.FixtureBegin()
	follower.Follow(engine.NewTransform3D(engine.NewVec3(1, 2, 3)))
	if bytes := engine.FixtureCommands(); binary.LittleEndian.Uint32(bytes[27:31]) != 1000020 {
		t.Fatal("marker retained stale actor", bytes)
	}
	engine.FixtureBegin()
	spinner.Update(5)
	spinner.Update(5)
	if bytes := engine.FixtureCommands(); binary.LittleEndian.Uint32(bytes[16:20]) != 1 || binary.LittleEndian.Uint32(bytes[27:31]) != 1000021 {
		t.Fatal("spinner retained actor/duplicated a frame", bytes)
	}
	engine.FixtureBegin()
	controller := controllerFixture()
	controller.Close()
	engine.FixtureBegin()
	controller.Update()
	controller.OnTransformChanged(engine.Transform3D{})
	if count := commandCount(); count != 0 {
		t.Fatal("disposed cameras received commands", count)
	}
}

func TestFPSMouseRunAndReset(t *testing.T) {
	engine.FixtureBegin()
	game := &Game{cameraController: controllerFixture()}
	original := game.camera.Settings()
	game.onPointer(engine.PointerInput{Kind: engine.PointerMouse, Phase: engine.PointerMove, Captured: true, DeltaX: 20, DeltaY: -12})
	game.Update()
	if game.camera.Settings().Yaw <= original.Yaw || game.camera.Settings().Pitch <= original.Pitch {
		t.Fatal("mouse look did not change both angles")
	}
	looked := game.camera.Settings()
	game.Update()
	if game.camera.Settings() != looked {
		t.Fatal("mouse displacement was consumed more than once")
	}
	game.forward, game.strafeRight, game.runLeft = true, true, true
	game.Update()
	next := game.camera.Settings()
	if distance := math.Hypot(float64(next.Position.X-looked.Position.X), float64(next.Position.Y-looked.Position.Y)); math.Abs(distance-.08) > 1e-6 {
		t.Fatal("sprint diagonal speed", distance)
	}
	game.Hooks().OnInputReset()
	engine.FixtureBegin()
	game.Update()
	if commandCount() != 0 {
		t.Fatal("reset retained input")
	}
}
func TestIsometricPanZoomAndFPSIsolation(t *testing.T) {
	engine.FixtureBegin()
	game := &Game{cameraController: controllerFixture()}
	game.isometric = true
	fps := game.camera.Settings()
	original := game.orbitCamera.Settings()
	game.forward, game.strafeRight = true, true
	game.Update()
	if game.camera.Settings() != fps || game.orbitCamera.Settings().Position == original.Position {
		t.Fatal("pan moved player or did not move isometric camera")
	}
	game.Stop()
	game.Zoom(.5)
	if game.orbitCamera.Settings().OrthoHeight != 15 {
		t.Fatal("zoom did not scale projection")
	}
	game.Zoom(.001)
	if game.orbitCamera.Settings().OrthoHeight != 8 {
		t.Fatal("zoom lower bound")
	}
	game.Zoom(100)
	if game.orbitCamera.Settings().OrthoHeight != 60 {
		t.Fatal("zoom upper bound")
	}
	game.ResetOrbit()
	if game.orbitCamera.Settings() != original || game.camera.Settings() != fps {
		t.Fatal("reset did not restore independent orbit")
	}
}
func TestTouchWalkLookPinchAndRelease(t *testing.T) {
	engine.FixtureBegin()
	game := &Game{cameraController: controllerFixture()}
	touch := func(id uint32, phase engine.PointerPhase, x, y float32) {
		game.onPointer(engine.PointerInput{ID: id, Kind: engine.PointerTouch, Phase: phase, X: x, Y: y})
	}
	touch(1, engine.PointerDown, 50, 100)
	touch(2, engine.PointerDown, 250, 100)
	touch(1, engine.PointerMove, 90, 50)
	touch(2, engine.PointerMove, 270, 80)
	game.Update()
	if game.camera.Settings().Position == game.fps.Position || game.camera.Settings().Pitch == game.fps.Pitch {
		t.Fatal("simultaneous touch movement/look missing")
	}
	touch(1, engine.PointerUp, 90, 50)
	touch(2, engine.PointerUp, 270, 80)
	if game.touchMove != 0 || game.touchStrafe != 0 {
		t.Fatal("touch release retained movement")
	}
	game.Stop()
	game.isometric = true
	touch(1, engine.PointerDown, 100, 100)
	touch(2, engine.PointerDown, 200, 100)
	touch(2, engine.PointerMove, 250, 100)
	game.Update()
	if game.orbitCamera.Settings().OrthoHeight >= 30 || game.offsetX == 0 {
		t.Fatal("pinch scale/pan missing")
	}
	game.Stop()
	touch(2, engine.PointerMove, 270, 100)
	engine.FixtureBegin()
	game.Update()
	if commandCount() != 0 {
		t.Fatal("stale touch changed camera after reset")
	}
}

func TestLowerScreenJoystickWithControls(t *testing.T) {
	engine.FixtureBegin()
	game := &Game{cameraController: controllerFixture()}
	game.showControls()
	touch := func(phase engine.PointerPhase, x, y float32) {
		game.onPointer(engine.PointerInput{ID: 1, Kind: engine.PointerTouch, Phase: phase, X: x, Y: y})
	}
	// The HUD stays visible, and the thumb may sit below the game rectangle
	// when a landscape scene is presented on a portrait phone.
	touch(engine.PointerDown, 50, 220)
	if game.pointers[0].id != 1 || game.moveStick.base == nil || game.moveStick.base.Alpha() != 1 {
		t.Fatal("lower-screen touch did not activate the visible joystick")
	}
	touch(engine.PointerMove, 54, 216)
	if game.touchMove != 0 || game.touchStrafe != 0 {
		t.Fatal("joystick jitter escaped the dead zone")
	}
	touch(engine.PointerMove, 150, 120)
	if length := math.Hypot(float64(game.touchMove), float64(game.touchStrafe)); math.Abs(length-1) > 1e-6 {
		t.Fatal("diagonal joystick was not normalized", length)
	}
	thumb := game.moveStick.thumb.Position()
	base := game.moveStick.base.Position()
	if base.Y >= 180 || base.Y-moveStickRadius < 0 || base.X-moveStickRadius < 0 {
		t.Fatal("portrait joystick indicator was clipped outside the scene", base)
	}
	if length := math.Hypot(float64(thumb.X-base.X), float64(thumb.Y-base.Y)); math.Abs(length-float64(moveStickRadius)) > 1e-5 {
		t.Fatal("visible thumb exceeded the joystick radius", length)
	}
	game.Hooks().OnInputReset()
	if game.touchMove != 0 || game.touchStrafe != 0 || game.moveStick.base.Alpha() != 0 || game.pointers[0].id != 0 {
		t.Fatal("input reset retained joystick movement or overlay")
	}
	touch(engine.PointerDown, 50, 160)
	touch(engine.PointerMove, 50, 100)
	touch(engine.PointerUp, 50, 100)
	if game.touchMove != 0 || game.moveStick.base.Alpha() != 0 {
		t.Fatal("touch release retained joystick movement or overlay")
	}
}
