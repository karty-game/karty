<template>
  <panel class="screen" modal="false">
    <panel class="toolbar">
      <label class="status">{ props.Status() }</label>
      <panel class="row">
        <button enabled={ props.Ready() && !props.Courtyard() } onClick={ court }>Roman court</button>
        <button enabled={ props.Ready() && props.Courtyard() } onClick={ gallery }>Gallery</button>
      </panel>
      <panel class="row">
        <button enabled={ props.Ready() && props.Isometric() } onClick={ fps }>FPS</button>
        <button enabled={ props.Ready() && !props.Isometric() } onClick={ iso }>Isometric</button>
        <button onClick={ props.Hide }>Hide</button>
      </panel>
      if props.Inspecting() {
        <panel class="diagnostics"><label class="pose">{ props.Pose() }</label></panel>
      }
    </panel>
    <panel class="footer">
      if props.Isometric() && !props.Inspecting() {
        <panel class="dock">
          <panel class="row">
            <button enabled={ props.Ready() } onClick={ orbitLeft }>Orbit ←</button>
            <button enabled={ props.Ready() } onClick={ props.Reset }>Center</button>
            <button enabled={ props.Ready() } onClick={ orbitRight }>Orbit →</button>
          </panel>
          <panel class="row">
            <button enabled={ props.Ready() } onClick={ zoomIn }>Zoom +</button>
            <button enabled={ props.Ready() } onClick={ zoomOut }>Zoom −</button>
          </panel>
        </panel>
      }
      <panel class="help-panel"><label class="help">{ props.Help() }</label></panel>
      <panel class="safe-area" />
    </panel>
  </panel>
</template>

<script setup lang="go">
type ControlsProps struct {
	Help func() string
	Inspecting func() bool
	Zoom func(float32)
	Reset func()
	Ready     func() bool
	Status    func() string
	Pose      func() string
	Isometric func() bool
	Courtyard func() bool
	View      func(bool)
	Visit     func(bool)
	Orbit     func(float32)
	Hide      func()
}

func setup(props ControlsProps) {
	zoomIn := func() { props.Zoom(0.8) }
	zoomOut := func() { props.Zoom(1.25) }
	fps := func() { props.View(false) }
	iso := func() { props.View(true) }
	gallery := func() { props.Visit(false) }
	court := func() { props.Visit(true) }
	orbitLeft := func() { props.Orbit(-1) }
	orbitRight := func() { props.Orbit(1) }
}
</script>

<style>
.screen
  background: #00000000
  padding: 12
  gap: 8
  align: stretch
  justify: space-between
.toolbar
  background: #151b1ce8
  padding: 8
  gap: 6
  align: stretch
.status
  color: #edf1eaff
  font-size: 16
.row
  direction: row
  gap: 6
  align: stretch
.dock
  background: #151b1ce8
  padding: 8
  gap: 6
  align: stretch
  max-width: 680
.footer
  align: stretch
  gap: 0
.safe-area
  min-height: 56
  max-height: 56
.help-panel
  background: #151b1ce8
  padding: 8
.help
  color: #edf1eaff
  font-size: 13
.diagnostics
  overflow: scroll
  max-height: 124
  min-height: 80
.pose
  color: #acccbdff
  font-size: 12
  font-family: mono
button
  background: #344247ff
  color: #f1f4efff
  min-height: 44
  font-size: 16
  flex-grow: 1
button:hover
  background: #496161ff
button:focus
  background: #507561ff
button:pressed
  background: #215246ff
button:disabled
  background: #26302cff
  color: #92ab9bff
@media (max-width: 600)
  .screen
    padding: 8
  .toolbar
    padding: 6
  .dock
    max-width: 600
  button
    font-size: 14
  .pose
    font-size: 10
</style>
