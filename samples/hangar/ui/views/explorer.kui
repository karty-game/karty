<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="eyebrow">KARTY / ENVIRONMENT STUDY</label>
      <label class="title">THE HANGAR</label>
      <label class="status">{ props.Status() }</label>
    </panel>
    <panel class="camera-panel">
      <panel class="row">
        <button onClick={ props.ToggleTorch }>{ torchLabel() }</button>
        <!-- Point-light demo paused: <button onClick={ props.LaunchLight }>Light bolt</button> -->
        <button class="camera-toggle" onClick={ props.ToggleCamera }>{ cameraLabel() }</button>
      </panel>
      if props.CameraOpen() {
        <panel class="views">
          <panel class="row">
            <button onClick={ arrival }>Arrival</button>
            <button onClick={ reactor }>Reactor</button>
          </panel>
          <panel class="row">
            <button onClick={ control }>Control</button>
            <button onClick={ zigzag }>Zigzag</button>
          </panel>
          <panel class="row">
            <button onClick={ loading }>Loading</button>
            <button onClick={ exit }>Extraction</button>
          </panel>
          <panel class="row">
            <button onClick={ windows }>Windows</button>
            <button onClick={ acidControl }>Acid control</button>
          </panel>
          <panel class="row">
            <button onClick={ barrel }>Burning barrel</button>
            <button onClick={ props.Hide }>Hide</button>
          </panel>
          <panel class="row">
            <button onClick={ underAcid }>Under acid</button>
            <button onClick={ floatDemo }>Float demo</button>
          </panel>
          <label class="help">{ props.Controls() }</label>
        </panel>
      }
    </panel>
  </panel>
</template>

<script setup lang="go">
type ExplorerProps struct {
	Status func() string
	Controls func() string
	Visit func(int)
	Hide func()
	CameraOpen func() bool
	ToggleCamera func()
	TorchEnabled func() bool
	ToggleTorch func()
	// LaunchLight func() // Point-light demo paused.
}

func setup(props ExplorerProps) {
	torchLabel := func() string {
		if props.TorchEnabled() {
			return "Torch on"
		}
		return "Torch off"
	}
	cameraLabel := func() string {
		if props.CameraOpen() {
			return "Camera -"
		}
		return "Camera +"
	}
	arrival := func() { props.Visit(0) }
	reactor := func() { props.Visit(1) }
	control := func() { props.Visit(2) }
	zigzag := func() { props.Visit(3) }
	loading := func() { props.Visit(4) }
	exit := func() { props.Visit(5) }
	windows := func() { props.Visit(6) }
	acidControl := func() { props.Visit(7) }
	barrel := func() { props.Visit(8) }
	underAcid := func() { props.Visit(9) }
	floatDemo := func() { props.Visit(10) }
}
</script>

<style>
.screen
  width: 100%
  height: 100%
  padding: 28
.heading
  align: start
  gap: 6
.eyebrow
  font-size: 11
  color: #a5b4ab
.title
  font-size: 30
  color: #e5e4d0
.status
  font-size: 13
  color: #d9b771
.camera-panel
  position: absolute
  top: 0
  right: 0
  align: end
  gap: 6
.camera-toggle
  min-width: 112
.help
  font-size: 11
  max-width: 220
  color: #d5d5c6
.views
  width: 260
  align: stretch
  gap: 6
  padding: 10
  background: #141e22e8
.row
  direction: row
  gap: 6
button
  min-height: 44
  min-width: 80
  flex-grow: 1
  font-size: 12
  background: #26332e
  color: #d9dcc8
button:hover
  background: #445342
  color: #ffedb5
@media (max-width: 900)
  .screen
    padding: 16
  .title
    font-size: 24
  .camera-panel
    top: 100
    right: 0
  .views
    width: 260
    height: 190
    overflow: scroll
  .eyebrow
    font-size: 10
</style>
