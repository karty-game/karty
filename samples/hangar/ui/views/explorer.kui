<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="eyebrow">KARTY / ENVIRONMENT STUDY</label>
      <label class="title">THE HANGAR</label>
      <label class="status">{ props.Status() }</label>
    </panel>
    <panel class="footer">
      <label class="help">{ props.Controls() }</label>
      <panel class="views">
        <button onClick={ arrival }>Arrival</button>
        <button onClick={ reactor }>Reactor</button>
        <button onClick={ control }>Control</button>
        <button onClick={ zigzag }>Zigzag</button>
        <button onClick={ loading }>Loading</button>
        <button onClick={ exit }>Extraction</button>
        <button onClick={ windows }>Windows</button>
        <button onClick={ props.Hide }>Hide</button>
      </panel>
    </panel>
  </panel>
</template>

<script setup lang="go">
type ExplorerProps struct {
	Status func() string
	Controls func() string
	Visit func(int)
	Hide func()
}

func setup(props ExplorerProps) {
	arrival := func() { props.Visit(0) }
	reactor := func() { props.Visit(1) }
	control := func() { props.Visit(2) }
	zigzag := func() { props.Visit(3) }
	loading := func() { props.Visit(4) }
	exit := func() { props.Visit(5) }
	windows := func() { props.Visit(6) }
}
</script>

