  font-size: 30
  color: #f0f0db
.status
  font-size: 12
  color: #dfc892
.styles
  position: absolute
  top: 0
  right: 0
  align: end
  gap: 8
.current
  font-size: 12
  color: #b6d9cf
.weather
  position: absolute
  bottom: 64
  right: 0
  width: 346
  padding: 10
  align: stretch
  gap: 6
  background: #163334e8
.times
  width: 100%
  direction: row
  gap: 6
.time
  min-width: 72
.clouds
  width: 100%
  direction: row
  gap: 6
  align: center
.help
  font-size: 11
  color: #dbe2d9
.row
  direction: row
  gap: 6
button
  min-height: 44
  min-width: 82
  flex-grow: 1
  font-size: 12
  background: #163334e8
  color: #ecedda
button:hover
  background: #34625b
  color: #ffedb5
.hide
  min-height: 30
  font-size: 10
@media (max-width: 600)
  .screen
    padding: 12
  .heading
    gap: 4
  .title
    font-size: 20
  .status
    font-size: 10
  .styles
    top: 130
    width: 100%
    align: start
    gap: 5
  .row
    width: 100%
  .help
    font-size: 10
  .weather
    width: 100%
</style>
