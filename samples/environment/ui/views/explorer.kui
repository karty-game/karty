<template>
  <panel class="screen" modal="true" onBack={ props.Close }>
    <panel class="drawer">
      <label class="title">OPEN AIR / DAYLIGHT</label>
      <label class="current">{ props.Environment() }</label>
      <panel class="row">
        <button onClick={ windows }>Windows</button>
        <button onClick={ courtyard }>Courtyard</button>
      </panel>
      <panel class="row">
        <button onClick={ lookBack }>Look back</button>
        <button onClick={ ground }>Test ground</button>
      </panel>
      <panel class="row">
        <button onClick={ morning }>Morning</button>
        <button onClick={ noon }>Noon</button>
        <button onClick={ evening }>Evening</button>
        <button onClick={ night }>Night</button>
      </panel>
      <panel class="row">
        <button onClick={ clearClouds }>Clear</button>
        <button onClick={ fewerClouds }>Fewer</button>
        <button onClick={ moreClouds }>More</button>
        <button onClick={ maximumClouds }>Max</button>
      </panel>
      <panel class="row">
        <button onClick={ props.ResetEnvironment }>Reset</button>
        <button onClick={ props.Close }>Close controls</button>
      </panel>
    </panel>
  </panel>
</template>

<script setup lang="go">
type ExplorerProps struct {
  Visit func(int)
  Close func()
  Environment func() string
  SetTime func(float32)
  CloudAmount func() int32
  SetCloudAmount func(int32)
  ResetEnvironment func()
}

func setup(props ExplorerProps) {
  windows := func() { props.Visit(0) }
  courtyard := func() { props.Visit(1) }
  lookBack := func() { props.Visit(2) }
  ground := func() { props.Visit(3) }
  morning := func() { props.SetTime(9) }
  noon := func() { props.SetTime(12) }
  evening := func() { props.SetTime(17) }
  night := func() { props.SetTime(0) }
  clearClouds := func() { props.SetCloudAmount(0) }
  fewerClouds := func() {
    amount := props.CloudAmount() - 10
    if amount < 0 { amount = 0 }
    props.SetCloudAmount(amount)
  }
  moreClouds := func() {
    amount := props.CloudAmount() + 10
    if amount > 100 { amount = 100 }
    props.SetCloudAmount(amount)
  }
  maximumClouds := func() { props.SetCloudAmount(100) }
}
</script>

<style>
.screen
  background: #00000055
.drawer
  position: absolute
  left: 8
  top: 8
  width: 360
  padding: 4
  gap: 4
  align: stretch
  background: #141b24ff
.title
  font-size: 18
  color: #edf1f6ff
.current
  font-size: 14
  color: #adbfceff
.row
  direction: row
  gap: 4
  align: stretch
button
  min-height: 44
  min-width: 44
  grow: 1
  font-size: 12
  background: #33475aff
  color: #f3f6faff
button:hover
  background: #496681ff
button:focus
  background: #537795ff
button:pressed
  background: #295b7bff
@media (max-width: 600)
  .drawer
    right: 8
    width: auto
</style>
