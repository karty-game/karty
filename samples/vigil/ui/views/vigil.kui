<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="eyebrow">THE ABBEY BELOW</label>
      <label class="title">V I G I L</label>
      <label class="area">{ props.Area() }</label>
    </panel>
    <panel class="objective">
      <label class="eyebrow">KEEP THE LIGHT</label>
      <label class="count">{ props.Progress() }</label>
      <label class="subtle">vigil lights</label>
    </panel>
    <panel class="bottom">
      if props.Prompt() != "" {
        <button class="interact" onClick={ props.Interact }>{ props.Prompt() }</button>
      }
      if props.Help() {
        <label class="help">Click / tap to walk · WASD / arrows</label>
        <label class="help">Shift: hasten · E / Space: rekindle</label>
        <label class="help">F: fireball · R: restart · H: hide help</label>
      }
    </panel>
    <panel class="tools">
      <button class="fireball" enabled={ props.SpellReady() } onClick={ props.Fireball }>F · Fireball</button>
      <button onClick={ props.ZoomOut }>−</button>
      <button onClick={ props.ZoomIn }>+</button>
    </panel>
    <panel class="camera-placement">
      <CameraSettings props={ props.Camera }/>
    </panel>
  </panel>
</template>
<script setup lang="go">
type VigilProps struct {
  Camera CameraSettingsProps
  Area func() string
  Status func() string
  Progress func() string
  Prompt func() string
  Help func() bool
  ToggleHelp func()
  Interact func()
  Reset func()
  Fireball func()
  SpellReady func() bool
  ZoomIn func()
  ZoomOut func()
}
func setup(props VigilProps) {}
</script>
