<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="title">{ props.Status() }</label>
      <label>WASD move · Mouse / arrows look · Space shoot · B blast · R reset</label>
      <label class="help">Touch: drag left to MOVE · drag right to LOOK · hold SHOOT</label>
    </panel>
    <panel class="actions">
      <button onClick={ props.Reset }>RESET</button>
      <button onClick={ props.Blast }>BLAST</button>
    </panel>
    <!-- Full-frame game input uses a vertical fit. The centered SHOOT shape
         is at 81.25% height, matching the center of this passive UI band.
         Labels never capture down/up, so held fire and multi-touch survive. -->
    <panel class="shoot-overlay">
      <panel class="shoot-spacer"/>
      <panel class="shoot-band">
        <label class="shoot-label">SHOOT</label>
      </panel>
    </panel>
  </panel>
</template>

