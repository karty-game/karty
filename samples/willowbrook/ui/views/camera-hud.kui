<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="title">{ props.Title() }</label>
    </panel>
    <panel class="camera-placement">
      <CameraSettings props={ props.Camera }/>
    </panel>
    <panel class="journal-clearance"/>
    <panel class="journal-placement">
      if props.JournalReady() && props.JournalOpen() {
        <button class="journal-open" onClick={ props.ActivateJournal }>{ props.JournalText() }</button>
      }
      if props.JournalReady() && !props.JournalOpen() {
        <button class="journal-compact" onClick={ props.ActivateJournal }>{ props.JournalText() }</button>
      }
    </panel>
  </panel>
</template>
<script setup lang="go">
type CameraHUDProps struct {
  Camera CameraSettingsProps
  Title func() string
  JournalText func() string
  JournalOpen func() bool
  JournalReady func() bool
  ActivateJournal func()
}
func setup(props CameraHUDProps) {}
</script>
