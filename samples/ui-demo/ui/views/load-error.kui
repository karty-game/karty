<template>
  <WindowLayout onBack={ back }>
    <fragment slot="title"><label class="title">Could not load level</label></fragment>
    <label>{ diagnostic }</label>
    <button class="primary" onClick={ retry }>Retry</button>
    <button class="secondary" onClick={ back }>Back</button>
    <fragment slot="footer"><label class="hint">Retry your destination or return to the main menu.</label></fragment>
  </WindowLayout>
</template>

<script setup lang="go">
func setup(props AppProps, diagnostic string) {
	retry := func() { props.Mount(props.Level()) }
	back := func() { props.Show(Menu(props)) }
}
</script>

<style>
.title
  color: theme.colors.accent
  font-size: theme.typography.title
.hint
  color: theme.colors.text-disabled
.primary
  background: theme.colors.primary
  color: theme.colors.text
  min-height: theme.controls.height
.primary:hover
  background: theme.colors.primary-hover
  color: theme.colors.accent
.primary:pressed
  background: theme.colors.primary-pressed
.secondary
  background: theme.colors.surface-raised
  color: theme.colors.text
  min-height: theme.controls.height
.secondary:hover
  background: theme.colors.primary-hover
.secondary:pressed
  background: theme.colors.primary-pressed
@media (max-width: 480)
  .title
    font-size: 24px
</style>
