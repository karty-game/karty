setup Pause(props AppProps) {
    resume := func() { props.Resume() }
    inventory := func() {
        props.Show(Inventory(InventoryProps{
            Quantity: props.Quantity,
            UsePotion: props.UsePotion,
            Back: func() { props.Show(Pause(props)) },
        }))
    }
    leave := func() { props.Leave() }
}

kartui Pause {
    <WindowLayout>
        <fragment slot="title"><label class="title">Paused</label></fragment>
        <button class="primary" onClick={ resume }>Resume</button>
        <button class="primary" onClick={ inventory }>Inventory</button>
        <button class="danger" onClick={ leave }>Return to menu</button>
        <fragment slot="footer"><label class="hint">Gameplay remains mounted behind this modal view.</label></fragment>
    </WindowLayout>
}

style {
    .title { color: theme.colors.accent; font-size: theme.typography.title; }
    .hint { color: theme.colors.text-disabled; }
    .primary { background: theme.colors.primary; color: theme.colors.text; min-height: theme.controls.height; }
    .primary:hover { background: theme.colors.primary-hover; color: theme.colors.accent; }
    .primary:pressed { background: theme.colors.primary-pressed; }
    .danger { background: theme.colors.disabled; color: theme.colors.text; min-height: theme.controls.height; }
    .danger:hover { background: theme.colors.primary-hover; }
    .danger:pressed { background: theme.colors.primary-pressed; }
}
