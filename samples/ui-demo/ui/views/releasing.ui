kartui Releasing(props AppProps) {
    <WindowLayout>
        <fragment slot="title"><label class="title">Leaving level</label></fragment>
        <label>Releasing level-owned assets and entities.</label>
        <fragment slot="footer"><label class="hint">You will return to the main menu.</label></fragment>
    </WindowLayout>
}

style {
    .title { color: theme.colors.accent; font-size: theme.typography.title; }
    .hint { color: theme.colors.text-disabled; }
}
