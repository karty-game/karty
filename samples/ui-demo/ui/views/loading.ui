kartui Loading(props AppProps) {
    <WindowLayout>
        <fragment slot="title"><label class="title">Loading</label></fragment>
        <label>Please wait while the level data is mounted.</label>
        <fragment slot="footer"><label class="hint">The UI stays responsive while content changes.</label></fragment>
    </WindowLayout>
}

style {
    .title { color: theme.colors.accent; font-size: theme.typography.title; }
    .hint { color: theme.colors.text-disabled; }
}
