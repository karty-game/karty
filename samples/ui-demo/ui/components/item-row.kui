<template>
  <panel modal="true" class="item">
    <label class="item-label">{ "Item " + strconv.Itoa(int(props.ID)) + " — used " + strconv.Itoa(uses) + " times" }</label>
    <button class="use" enabled={ props.Quantity() > 0 } onClick={ use }>{ "Use (" + strconv.Itoa(props.Quantity()) + ")" }</button>
  </panel>
</template>

<script setup lang="go">
import "strconv"

// A reusable child: no Game dependency; every keyed instance owns its counter.
type ItemRowProps struct {
	ID       uint32
	Quantity func() int
	Use      func() bool
	Changed  func()
}

func setup(props ItemRowProps) {
	uses := 0
	use := func() {
		if props.Use() {
			uses++
			invalidate()
			props.Changed()
		}
	}
}
</script>

<style>
.item
  gap: 4
  padding: 2
  margin: 1
  min-height: 36
  max-height: 36
  direction: row
  align: center
.item-label
  color: theme.colors.accent
  font-size: 16
  flex-grow: 1
.use
  background: theme.colors.primary
  color: theme.colors.text
  font-size: 14
  min-height: 32
  transition-duration: theme.controls.transition
.use:hover
  background: theme.colors.primary-hover
  color: theme.colors.accent
.use:pressed
  background: theme.colors.primary-pressed
.use:disabled
  background: theme.colors.disabled
  color: theme.colors.text-disabled
@media (max-width: 480)
  .item
    gap: 3
    padding: 2
    margin: 1
    min-height: 36
    max-height: 36
  .item-label
    font-size: 14
    max-width: 250
  .use
    font-size: 14
    min-height: 32
</style>
