<template>
  <panel class="phone-stage">
    if props.Model.Scene == "platform" && props.Renderer.Ready("platform") {
      <TrainImage source={ props.Renderer.Source("platform") } props={ TrainImageProps{} }/>
    }
    if props.Model.Scene == "carriage" && props.Renderer.Ready("carriage") {
      <TrainImage source={ props.Renderer.Source("carriage") } props={ TrainImageProps{} }/>
    }
    if props.Model.Scene == "dining" && props.Renderer.Ready("dining") {
      <TrainImage source={ props.Renderer.Source("dining") } props={ TrainImageProps{} }/>
    }
    if props.Renderer.Ensemble() {
      <panel class="ensemble-left"><TrainPortrait props={ TrainPortraitProps{Name: "mara", Renderer: props.Renderer} }/></panel>
      <panel class="ensemble-middle"><TrainPortrait props={ TrainPortraitProps{Name: "elias", Renderer: props.Renderer} }/></panel>
      <panel class="ensemble-right"><TrainPortrait props={ TrainPortraitProps{Name: "iris", Renderer: props.Renderer} }/></panel>
    }
    if !props.Renderer.Ensemble() {
      <panel class="single"><TrainActor props={ TrainActorProps{Model: props.Model, Renderer: props.Renderer} }/></panel>
    }
  </panel>
</template>
<script setup lang="go">
import "github.com/karty-game/dialogue"
import "example.com/last-train/internal/stage"
type TrainStageProps struct { Model *dialogue.Model; Renderer *stage.Renderer }
func setup(props TrainStageProps) {}
</script>
