<template>
  <NovelFrame onBack={ props.Log }>
    <fragment slot="scene">
      <TrainStage props={ TrainStageProps{Model: props.Model, Renderer: props.Visual} }/>
      <button class="scene-advance" enabled={ !props.Stage.Title && !props.Stage.Transition && !props.Model.ShowHistory && !props.Model.Paused && !props.Model.Done && len(props.Model.Choices) == 0 } onClick={ props.Advance }/>
    </fragment>
    <fragment slot="heading">
      if !props.Stage.Title {
      <label class="title">LAST TRAIN</label>
      <label class="location">{ props.Model.Location }</label>
      <button class="save-info" onClick={ props.Slot }>{ "Slot " + props.Controls.Slot + " · Endings " + props.Controls.Endings + "/3" }</button>
      }
    </fragment>
    <fragment slot="toolbar">
      if !props.Stage.Title {
      <button onClick={ props.Save }>Save</button>
      <button onClick={ props.Load }>Load</button>
      <button onClick={ props.Log }>Log</button>
      <button onClick={ props.Music }>Music</button>
      <button onClick={ props.Ambience }>Train</button>
      <button onClick={ props.Restart }>Restart</button>
      }
    </fragment>
    if !props.Stage.Title && !props.Stage.Transition {
    <NovelDialogue props={ NovelDialogueProps{Model: props.Model, Advance: props.Advance, Choose: props.Choose} }/>
    }
    <fragment slot="overlay">
      if props.Stage.Title {
        <panel class="opening">
          <panel class="opening-copy">
            <label class="overline">WESTBRIDGE · 23:47 · AUTUMN 1934</label>
            <label class="opening-title">LAST TRAIN</label>
            <panel class="gold-rule"/>
            <label class="tagline">Some promises outlive the journey.</label>
            <label class="invitation">A quiet railway mystery in three encounters.</label>
            <button class="begin" onClick={ props.Begin }>Begin the journey  ›</button>
            <button onClick={ props.Load }>{ "Load journey · Slot " + props.Controls.Slot }</button>
            <button onClick={ props.Slot }>{ "Choose save slot · " + props.Controls.Slot + " of 3" }</button>
            <label class="instructions">Read at your own pace. Click once to finish a line, then again to continue.</label>
            <label class="opening-status">{ props.Model.Status }</label>
            <button onClick={props.Motion}>{props.Controls.Motion}</button>
          </panel>
        </panel>
      }
      if props.Stage.Cover {
        <panel class="curtain">
          <label class="chapter">{ props.Stage.Chapter }</label>
          <panel class="chapter-rule"/>
          <label class="chapter-subtitle">{ props.Stage.Subtitle }</label>
        </panel>
      }
      if props.Model.ShowHistory {
        <NovelHistory props={ NovelHistoryProps{Model: props.Model, Close: props.Log} }/>
      }
    </fragment>
  </NovelFrame>
</template>

<script setup lang="go">
import "github.com/karty-game/dialogue"
import "example.com/last-train/internal/persistence"
import "example.com/last-train/internal/presentation"
import "example.com/last-train/internal/stage"
type TrainScreenProps struct {
    Model *dialogue.Model
    Stage *presentation.State
    Visual *stage.Renderer
    Motion func()
    Begin func()
    Controls *persistence.Controls
    Slot func()
    Advance func()
    Choose func(int)
    Save, Load, Log, Music, Ambience, Restart func()
}
func setup(props TrainScreenProps) {}
</script>

