<template>
  <panel class="screen" modal="false">
    <panel class="heading">
      <label class="title">Karty media lab</label>
      <label class="formats">Images: QOI · Sound: QOA · Video: MPEG-1</label>
    </panel>
    <panel class="controls">
      <label class="status">{ props.Status() }</label>
      <panel class="video-controls">
        <button onClick={ props.PlayVideo }>Play / replay video</button>
        <button onClick={ props.StopVideo }>Stop video</button>
      </panel>
      <panel class="audio-controls">
        <button class="one-shot" onClick={ props.OneShot }>ONE SHOT · 8-bit mono</button>
        <button class="burst" onClick={ props.Burst }>36-START BURST · 24-bit mono</button>
        <button class="music" onClick={ props.ToggleMusic }>{ musicLabel() }</button>
      </panel>
    </panel>
  </panel>
</template>
<script setup lang="go">
type MediaHUDProps struct {
  Status func() string
  MusicEnabled func() bool
  PlayVideo, StopVideo, OneShot, Burst, ToggleMusic func()
}
func setup(props MediaHUDProps) {
  musicLabel := func() string {
    if props.MusicEnabled() { return "BGM REPLAY: ON · stereo loop" }
    return "BGM REPLAY: OFF · stereo loop"
  }
}
</script>
