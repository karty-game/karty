<template>
  <panel class="copy">
    if !props.Model.Narration() {
      <label class="speaker">{ props.Model.Speaker }</label>
    }
    <panel class="text-area">
    if !props.Model.Narration() {
      <label class="line-space">{ props.Model.Text }</label>
      <label class="line" reveal={ props.Model.RevealCharacters() }>{ props.Model.Text }</label>
    } else {
      <label class="prose-space">{ props.Model.Text }</label>
      <label class="prose" reveal={ props.Model.RevealCharacters() }>{ props.Model.Text }</label>
    }
    </panel>
    <panel class="rule"/>
    if len(props.Model.Choices) > 0 {
      <panel class="choices">
        for _, option := range props.Model.Choices {
          <NovelChoice key={ uint32(option.ID + 1) } props={ NovelChoiceProps{Option: option, Choose: props.Choose} }/>
        }
      </panel>
    } else {
      <panel class="advance-row">
        <button class="advance" enabled={ !props.Model.Done && !props.Model.Paused } onClick={ props.Advance }>{ props.Model.AdvanceLabel() }</button>
      </panel>
    }
    <label class="status">{ props.Model.Status }</label>
  </panel>
</template>

<script setup lang="go">
import "github.com/karty-game/dialogue"

type NovelDialogueProps struct {
    Model *dialogue.Model
    Advance func()
    Choose func(int)
}

func setup(props NovelDialogueProps) {}
</script>

