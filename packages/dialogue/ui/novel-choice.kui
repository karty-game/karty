<template>
  <panel class="row">
    <button class="choice" enabled={ props.Option.Enabled } onClick={ choose }>{ props.Option.Text }</button>
  </panel>
</template>

<script setup lang="go">
import "github.com/karty-game/dialogue"
type NovelChoiceProps struct { Option dialogue.Option; Choose func(int) }
func setup(props NovelChoiceProps) { choose := func() { props.Choose(props.Option.ID) } }
</script>

